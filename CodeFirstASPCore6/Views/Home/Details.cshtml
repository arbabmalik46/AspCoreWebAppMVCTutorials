@model CodeFirstASPCore6.Models.Student

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Student</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">ID</dt>
        <dd class="col-sm-10">@Model.ID</dd>

        <dt class="col-sm-2">Name</dt>
        <dd class="col-sm-10">@Model.Name</dd>

        <dt class="col-sm-2">Description</dt>
        <dd class="col-sm-10">@Model.Description</dd>

        <dt class="col-sm-2">Email</dt>
        <dd class="col-sm-10">@Model.Email</dd>

        <dt class="col-sm-2">Phone Number</dt>
        <dd class="col-sm-10">@Model.PhoneNumber</dd>

        <dt class="col-sm-2">Date of Birth</dt>
        <dd class="col-sm-10">@Model.DateOfBirth.ToShortDateString()</dd>

        <dt class="col-sm-2">Enrollment Date</dt>
        <dd class="col-sm-10">@Model.EnrollmentDate.ToShortDateString()</dd>

        <dt class="col-sm-2">GPA</dt>
        <dd class="col-sm-10">@Model.GPA</dd>

        <dt class="col-sm-2">Tier</dt>
        <dd class="col-sm-10">@Model.Tier</dd>
    </dl>
</div>

<div>
    <a asp-action="Edit" asp-controller="Home" asp-route-id="@Model.ID">Edit</a> |
    <a asp-action="Index" asp-controller="Home">Back to List</a>
</div>