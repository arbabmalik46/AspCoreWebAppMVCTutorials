@model List<APIImplementation.Models.Student>
@{
    ViewData["Title"] = "Student List";
}

<div class="container mt-5">
    <div class="row mb-4">
        <div class="col-md-8">
            <h1 class="display-4">Students</h1>
        </div>
        <div class="col-md-4 text-end">
            <a asp-action="Create" class="btn btn-success btn-lg">
                <i class="bi bi-plus-circle"></i> Add New Student
            </a>
        </div>
    </div>

    @if (Model == null || Model.Count == 0)
    {
        <div class="alert alert-info" role="alert">
            No students found.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Full Name</th>
                        <th>Email</th>
                        <th>Phone Number</th>
                        <th>Date of Birth</th>
                        <th>Enrollment Date</th>
                        <th>GPA</th>
                        <th>Tier</th>
                        <th>Description</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var student in Model)
                    {
                        <tr>
                            <td>@student.StudentId</td>
                            <td>@student.FullName</td>
                            <td>@student.Email</td>
                            <td>@student.PhoneNumber</td>
                            <td>@student.DateOfBirth.ToString("MM/dd/yyyy")</td>
                            <td>@student.EnrollmentDate.ToString("MM/dd/yyyy")</td>
                            <td>@(student.Gpa?.ToString("F2") ?? "N/A")</td>
                            <td>@student.Tier</td>
                            <td>@student.Description</td>
                            <td>
                                <a asp-action="Edit" asp-route-id="@student.StudentId" class="btn btn-sm btn-primary">
                                    <i class="bi bi-pencil"></i> Edit
                                </a>
                                <a asp-action="Details" asp-route-id="@student.StudentId" class="btn btn-sm btn-success">
                                    <i class="bi bi-pencil"></i> Details
                                </a>
                                <form asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this student?');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@student.StudentId" />
                                    <button type="submit" class="btn btn-sm btn-danger">
                                        <i class="bi bi-trash"></i> Delete
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>