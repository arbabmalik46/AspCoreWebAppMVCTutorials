@model APIImplementation.Models.Student
@{
    ViewData["Title"] = "Student Details";
}

<div class="container mt-5">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <h1 class="mb-4">Student Details</h1>

            @if (Model == null)
            {
                <div class="alert alert-info">Student not found.</div>
            }
            else
            {
                <dl class="row">
                    <dt class="col-sm-3">ID</dt>
                    <dd class="col-sm-9">@Model.StudentId</dd>

                    <dt class="col-sm-3">Full Name</dt>
                    <dd class="col-sm-9">@Model.FullName</dd>

                    <dt class="col-sm-3">Email</dt>
                    <dd class="col-sm-9">@Model.Email</dd>

                    <dt class="col-sm-3">Phone</dt>
                    <dd class="col-sm-9">@Model.PhoneNumber</dd>

                    <dt class="col-sm-3">Date of Birth</dt>
                    <dd class="col-sm-9">@Model.DateOfBirth.ToString("MM/dd/yyyy")</dd>

                    <dt class="col-sm-3">Enrollment Date</dt>
                    <dd class="col-sm-9">@Model.EnrollmentDate.ToString("MM/dd/yyyy")</dd>

                    <dt class="col-sm-3">GPA</dt>
                    <dd class="col-sm-9">@(Model.Gpa.HasValue ? Model.Gpa.Value.ToString("F2") : "N/A")</dd>

                    <dt class="col-sm-3">Tier</dt>
                    <dd class="col-sm-9">@Model.Tier</dd>

                    <dt class="col-sm-3">Description</dt>
                    <dd class="col-sm-9">@Model.Description</dd>
                </dl>

                <div class="mt-4 d-flex gap-2">
                    <a asp-action="Edit" asp-route-id="@Model.StudentId" class="btn btn-primary">Edit</a>
                    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
                    <form asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this student?');">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.StudentId" />
                        <button type="submit" class="btn btn-sm btn-danger">
                            <i class="bi bi-trash"></i> Delete
                        </button>
                    </form>
                </div>
            }
        </div>
    </div>
</div>