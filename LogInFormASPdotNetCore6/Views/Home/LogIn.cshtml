@model LogInFormASPdotNetCore6.Models.User

@{
    ViewData["Title"] = "Log In";
}
<div>
    @{
        if(ViewBag.Message != null)
        {
            <div class="alert alert-danger" role="alert">
                @ViewBag.Message
            </div>
        }
    }
</div>
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-body">
                    <h1 class="card-title text-center mb-4">Log In</h1>

                    <form asp-action="LogIn" method="post">
                        <div class="mb-3">
                            <label asp-for="UserName" class="form-label">Username</label>
                            <input asp-for="UserName" class="form-control" placeholder="Enter your username" />
                            <span asp-validation-for="UserName" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="UserEmail" class="form-label">Email</label>
                            <input asp-for="UserEmail" type="email" class="form-control" placeholder="Enter your email" />
                            <span asp-validation-for="UserEmail" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="UserPassword" class="form-label">Password</label>
                            <input asp-for="UserPassword" type="password" class="form-control" placeholder="Enter your password" />
                            <span asp-validation-for="UserPassword" class="text-danger"></span>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-lg">Log In</button>
                        </div>
                    </form>

                    <hr />

                    <p class="text-center mt-3">
                        Don't have an account? <a asp-action="SignUp">Sign up here</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
